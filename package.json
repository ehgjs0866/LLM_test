{
  "name": "deskpet-harness-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "smoke": "tsx scripts/smoke.ts",
    "demo": "tsx demo/client.ts",
    "db": "tsx scripts/store.ts",
    "harness": "tsx scripts/server.ts",
    "web:dev": "pnpm --filter @deskpet/web dev",
    "web:build": "pnpm --filter @deskpet/web build",
    "web:fixture": "tsx scripts/web-fixture.ts"
  },
  "devDependencies": {
    "@deskpet/contracts": "workspace:*",
    "@deskpet/gateways": "workspace:*",
    "@deskpet/harness": "workspace:*",
    "@deskpet/llm": "workspace:*",
    "@deskpet/output": "workspace:*",
    "@deskpet/projector": "workspace:*",
    "@deskpet/server": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
