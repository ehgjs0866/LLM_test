# 실제 값은 .env 에만 넣는다. .env 는 .gitignore 대상이다. 로그·기록에 남기지 않는다.

# Eureka — 기본은 개발 환경 flw-d1. 키가 운영(flw-v1)용이면 여기서 바꾼다.
EUREKA_BASE_URL=https://api.eureka.codes/flw-d1
EUREKA_API_KEY=
# (선택) 연결 테스트에서 상태를 조회할 업무 itemId
EUREKA_TEST_ITEM_ID=
# 직접 경로 업무 등록(eureka.register)에 쓸 기본 프로세스 ID (pnpm smoke eureka의 프로세스 목록 참고). 비우면 등록하지 않음
EUREKA_DEFAULT_PROCESS_ID=
# 완료 근거 기록(D-28): 단계 완료 뒤 단계 기록(note)에 승인한 PR 주소를 남긴다. 기본 on, off로 끔
EUREKA_EVIDENCE_NOTE=on
# (선택) 기록 작성자 actorId (예: 1000011@10200 형태, 웹 F12의 note 요청 Payload에서 확인). 비우면 보내지 않음
EUREKA_NOTE_ACTOR_ID=

# 2차 의도 확인(D-29): 라우터가 llm·unclear로 보낸 요청을 LLM이 다시 보고 PR 리뷰·승인이면 규칙 경로로. 기본 on
DESKPET_INTENT_RECHECK=on
# (선택) 쓰기 입력 신뢰도 기준. 비우면 기본값(STT 0.85, 라우터 종합 0.8). 승인 요청·확인 답변 모두에 적용
DESKPET_MIN_STT_CONFIDENCE=
DESKPET_MIN_ROUTE_CONFIDENCE=

# GitHub — 읽기 권한 토큰이면 연결 테스트 가능. 쓰기(승인)는 코드에서 꺼져 있다.
GITHUB_TOKEN=
# (선택) 리뷰 조회를 시험할 저장소와 PR 번호
GITHUB_TEST_REPO=owner/name
GITHUB_TEST_PR=

# (선택) GitHub에서 필수 검사 설정을 쓸 수 없을 때(무료 요금제 비공개 저장소)만 쓰는 DeskPet 대체 목록
# 형식: owner/repo=검사1,검사2;owner2/repo2=검사
DESKPET_REQUIRED_CHECKS=
# PR CI 검사(D-30): 기본 skip — 검사를 조회하지 않고 승인 조건에서도 뺀다. enforce면 조회·필수 검사 확인
DESKPET_PR_CHECKS=skip

# (선택) pnpm demo에서 PR과 연결할 Eureka 업무·단계. 없으면 Eureka 후속 반영 단계는 생략된다.
# pnpm demo --item <itemId>를 쓰면 아래 두 값과 PR 번호 없이 Eureka 단계 기록의 PR 주소로 찾는다
DEMO_EUREKA_ITEM_ID=
DEMO_EUREKA_STAGE_ID=

# (선택) Harness 기록 저장소. 지정하면 SQLite 파일에 남기고, 다음 실행 시작 때 재시작 복구(결과 불명 쓰기는 읽기로만 확인)를 한다.
# 비우면 메모리 전용(실행이 끝나면 사라짐). Node 22.13 이상 필요.
DESKPET_STORE_PATH=.deskpet/harness.db

# LLM Wiki (D-19): 팀 vault 루트 경로 (wiki/, projects/가 있는 폴더). 읽기 전용, 비우면 Wiki 검색 안 함
# 예: DESKPET_WIKI_DIR=C:\Users\<이름>\deskpet-harness\knowledge-docs-pipeline\knowledge-docs-pipeline
DESKPET_WIKI_DIR=
# 저장된 값 조회(읽기 전용): pnpm db / pnpm db ops / pnpm db op <id> / pnpm db pending

# (선택) LLM — 기본은 꺼짐. 켜면 규칙이 모르는 의도에서 LLM 보조 Guide, 출력 문장 다듬기에 사용한다.
# LLM_PROVIDER=off | gemini | openai | remote (remote: 팀 원격 fallback API 어댑터 — 아직 없음)
# 공급자를 바꿀 때는 이 값과 해당 공급자의 키만 바꾸면 된다. 코드는 바꾸지 않는다.
LLM_PROVIDER=off

# Gemini (현재 개발 기본)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# (선택) 생각 수준 minimal|low|medium|high. 비우면 minimal (connection-test-issues #14: 높으면 시간 초과)
GEMINI_THINKING_LEVEL=minimal

# OpenAI (나중에 전환)
OPENAI_API_KEY=
OPENAI_MODEL=
# (선택) OpenAI 호환 endpoint를 쓸 때만
OPENAI_BASE_URL=

# 출력 경로: direct(기본, 공급자 중립) | langchain(openai에서만)
LLM_OUTPUT_CHAIN=direct
# 비용·폭주 방지 상한 (실측 후 조정)
LLM_MAX_CALLS_PER_MINUTE=20
# 자원별 동시 호출 상한 (D-24). LLM은 자리가 LLM_QUEUE_WAIT_MS 안에 안 나면 호출하지 않고 규칙·고정 문구로 대신한다
LLM_MAX_CONCURRENT=2
LLM_QUEUE_WAIT_MS=500
GITHUB_MAX_CONCURRENT=4
EUREKA_MAX_CONCURRENT=4
LLM_MAX_OUTPUT_TOKENS=400
# 출력 문장 모델 호출 시간 상한(ms). 넘으면 고정 문구
LLM_OUTPUT_TIMEOUT_MS=8000
# Guide(단계 선택) 호출 시간 상한(ms). 기본 8000
LLM_GUIDE_TIMEOUT_MS=8000
# 결과 불명·판정 대기 작업 주기 확인 간격(ms). 다시 보내지 않고 조회만 한다 (D-23)
RECOVERY_INTERVAL_MS=30000
# 요청마다 단계별 처리 시간을 서버 콘솔에 한 줄씩 (D-26). off로 끈다
DESKPET_TIMING_LOG=on
# POC 장애 주입 (D-27). pnpm harness … --poc 일 때만, flw-d1에서만. docs/poc-d21-d27.md
DESKPET_POC_FAULTS=
DESKPET_POC_SLOW_MS=5000

# Harness 서비스 서버 (pnpm harness) — WebSocket 경계
# 클라이언트(파이프라인·데모·웹) 인증 토큰. 16자 이상 임의 문자열. 서버와 클라이언트가 같은 값을 쓴다
HARNESS_WS_TOKEN=
# 웹 화면(구독 전용) 토큰. 16자 이상, 위 토큰과 다른 값. 브라우저에는 이 값만 입력한다
HARNESS_WS_VIEWER_TOKEN=
HARNESS_WS_HOST=127.0.0.1
HARNESS_WS_PORT=8787
# 브라우저 Origin 허용 목록 (쉼표 구분). 비우면 브라우저 접속 거부 (Node·Swift 클라이언트는 Origin을 보내지 않음)
HARNESS_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 다른 기기 접속 (D-25, docs/remote-access.md). 기본은 이 기기에서만.
# HARNESS_WS_HOST=0.0.0.0 으로 열 때는 접속을 받을 IP·대역이 필수이고, 토큰은 24자 이상이어야 한다
HARNESS_WS_ALLOWED_CLIENTS=
# 선택: TLS(wss://). PEM 파일 경로
HARNESS_WS_TLS_CERT=
HARNESS_WS_TLS_KEY=
# 데모 클라이언트(pnpm demo)가 접속할 주소
HARNESS_WS_URL=ws://127.0.0.1:8787

# Eureka 내부 API 서버 (D-31, pnpm eureka:server). 직접 Eureka 요청만 별도 프로세스에서 받는다
# Harness 서버를 DESKPET_EUREKA_BRIDGE=external로 켜면 그쪽은 eureka.*를 받지 않는다 (기본 internal: 지금처럼 함께 받음)
DESKPET_EUREKA_BRIDGE=internal
# 비우면 HARNESS_WS_TOKEN을 쓴다
EUREKA_WS_TOKEN=
EUREKA_WS_HOST=127.0.0.1
EUREKA_WS_PORT=8789
EUREKA_WS_ALLOWED_CLIENTS=
# 쓰기 작업 기록 (Harness의 DESKPET_STORE_PATH와 다른 파일)
EUREKA_STORE_PATH=
