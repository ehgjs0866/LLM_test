# 실제 값은 .env 에만 넣는다. .env 는 .gitignore 대상이다. 로그·기록에 남기지 않는다.

# Eureka — 기본은 개발 환경 flw-d1. 키가 운영(flw-v1)용이면 여기서 바꾼다.
EUREKA_BASE_URL=https://api.eureka.codes/flw-d1
EUREKA_API_KEY=
# (선택) 연결 테스트에서 상태를 조회할 업무 itemId
EUREKA_TEST_ITEM_ID=

# GitHub — 읽기 권한 토큰이면 연결 테스트 가능. 쓰기(승인)는 코드에서 꺼져 있다.
GITHUB_TOKEN=
# (선택) 리뷰 조회를 시험할 저장소와 PR 번호
GITHUB_TEST_REPO=owner/name
GITHUB_TEST_PR=
