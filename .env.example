# 실제 값은 .env 에만 넣는다. .env 는 .gitignore 대상이다. 로그·기록에 남기지 않는다.

# Eureka — 기본은 개발 환경 flw-d1. 키가 운영(flw-v1)용이면 여기서 바꾼다.
EUREKA_BASE_URL=https://api.eureka.codes/flw-d1
EUREKA_API_KEY=
# (선택) 연결 테스트에서 상태를 조회할 업무 itemId
EUREKA_TEST_ITEM_ID=

# GitHub — 읽기 권한 토큰이면 연결 테스트 가능. 쓰기(승인)는 코드에서 꺼져 있다.
GITHUB_TOKEN=
# (선택) 리뷰 조회를 시험할 저장소와 PR 번호
GITHUB_TEST_REPO=owner/name
GITHUB_TEST_PR=

# (선택) GitHub에서 필수 검사 설정을 쓸 수 없을 때(무료 요금제 비공개 저장소)만 쓰는 DeskPet 대체 목록
# 형식: owner/repo=검사1,검사2;owner2/repo2=검사
DESKPET_REQUIRED_CHECKS=

# (선택) pnpm demo에서 PR과 연결할 Eureka 업무·단계. 없으면 Eureka 후속 반영 단계는 생략된다.
DEMO_EUREKA_ITEM_ID=
DEMO_EUREKA_STAGE_ID=

# (선택) Harness 기록 저장소. 지정하면 SQLite 파일에 남기고, 다음 실행 시작 때 재시작 복구(결과 불명 쓰기는 읽기로만 확인)를 한다.
# 비우면 메모리 전용(실행이 끝나면 사라짐). Node 22.13 이상 필요.
DESKPET_STORE_PATH=.deskpet/harness.db
# 저장된 값 조회(읽기 전용): pnpm db / pnpm db ops / pnpm db op <id> / pnpm db pending

# (선택) LLM — 기본은 꺼짐. 켜면 규칙이 모르는 의도에서 LLM 보조 Guide, 출력 문장 다듬기에 사용한다.
# LLM_PROVIDER=off | gemini | openai | remote (remote: 팀 원격 fallback API 어댑터 — 아직 없음)
# 공급자를 바꿀 때는 이 값과 해당 공급자의 키만 바꾸면 된다. 코드는 바꾸지 않는다.
LLM_PROVIDER=off

# Gemini (현재 개발 기본)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# (선택) 생각 수준 minimal|low|medium|high. 비우면 모델 기본값
GEMINI_THINKING_LEVEL=

# OpenAI (나중에 전환)
OPENAI_API_KEY=
OPENAI_MODEL=
# (선택) OpenAI 호환 endpoint를 쓸 때만
OPENAI_BASE_URL=

# 출력 경로: direct(기본, 공급자 중립) | langchain(openai에서만)
LLM_OUTPUT_CHAIN=direct
# 비용·폭주 방지 상한 (실측 후 조정)
LLM_MAX_CALLS_PER_MINUTE=20
LLM_MAX_OUTPUT_TOKENS=400
# 출력 문장 모델 호출 시간 상한(ms). 넘으면 고정 문구
LLM_OUTPUT_TIMEOUT_MS=8000
