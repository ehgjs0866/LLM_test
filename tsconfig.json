{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@deskpet/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@deskpet/harness": [
        "packages/harness/src/index.ts"
      ],
      "@deskpet/gateways": [
        "packages/gateways/src/index.ts"
      ],
      "@deskpet/output": [
        "packages/output/src/index.ts"
      ],
      "@deskpet/projector": [
        "packages/projector/src/index.ts"
      ],
      "@deskpet/llm": [
        "packages/llm/src/index.ts"
      ],
      "@deskpet/server": [
        "packages/server/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "demo/**/*.ts"
  ]
}
